---
import '../styles/global.css';
import produtos from '../data/produtos.json';
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TechGamer - As melhores ofertas de periféricos e eletrônicos</title>
    <meta name="lomadee" content="2324685" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">
    
    <!-- Cabeçalho -->
    <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
        <h1 class="text-xl font-extrabold tracking-wider text-cyan-400">TECH<span class="text-white">GAMER</span></h1>
        <nav class="space-x-6 text-sm font-medium">
          <a href="#" class="hover:text-cyan-400 transition">Início</a>
          <a href="#" class="hover:text-cyan-400 transition">Periféricos</a>
          <a href="#" class="hover:text-cyan-400 transition">Hardware</a>
          <a href="#" class="hover:text-cyan-400 transition">Sobre</a>
        </nav>
      </div>
    </header>

    <!-- Conteúdo Principal -->
    <main class="flex-grow max-w-7xl mx-auto px-4 py-8 w-full">
      
      <!-- Seção de Destaque / Banner -->
      <section class="bg-gradient-to-r from-cyan-900/40 to-blue-900/40 border border-cyan-500/20 rounded-2xl p-8 mb-12 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Os melhores equipamentos para o seu setup</h2>
        <p class="text-slate-400 max-w-2xl mx-auto mb-6">Encontre análises sinceras e as melhores ofertas selecionadas na Amazon e no Mercado Livre para elevar o seu nível nos jogos.</p>
      </section>

      <!-- Grade de Produtos -->
      <h3 class="text-2xl font-bold mb-6 border-l-4 border-cyan-400 pl-3">Ofertas em Destaque</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {produtos.map((produto) => (
          <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden flex flex-col justify-between hover:border-cyan-500/50 transition group">
            <div>
              <div class="h-48 overflow-hidden bg-slate-800 relative">
                <span class={`absolute top-2 right-2 text-xs font-bold px-2.5 py-1 rounded-full text-white ${produto.badgeColor} z-10`}>
                  {produto.loja}
                </span>
                <img src={produto.imagem} alt={produto.nome} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
              </div>
              <div class="p-5">
                <h4 class="font-semibold text-lg mb-2 text-slate-100">{produto.nome}</h4>
                <p class="text-2xl font-bold text-cyan-400 mb-4">{produto.preco}</p>
              </div>
            </div>
            <div class="p-5 pt-0">
              <a 
                href={produto.link} 
                target="_blank" 
                rel="noopener noreferrer"
                class="block w-full text-center bg-cyan-600 hover:bg-cyan-500 text-white font-medium py-2.5 rounded-lg transition shadow-lg shadow-cyan-900/20"
              >
                Ver na Loja ➔
              </a>
            </div>
          </div>
        ))}
      </div>

    </main>

    <!-- Rodapé -->
    <footer class="border-t border-slate-800 bg-slate-900 py-6 text-center text-xs text-slate-500">
      <p>© 2026 TechGamer. Participamos de programas de afiliados da Amazon e Mercado Livre. Podemos ganhar comissões em compras qualificadas.</p>
    </footer>

  </body>
</html>